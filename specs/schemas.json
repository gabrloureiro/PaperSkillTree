{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "definitions": {
        "PaperChunkInput": {
            "type": "object",
            "required": [
                "raw_text",
                "section_header"
            ],
            "properties": {
                "raw_text": {
                    "type": "string",
                    "minLength": 50
                },
                "section_header": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "ExpertInput": {
            "type": "object",
            "required": [
                "node_id",
                "concept_name",
                "relevant_raw_text"
            ],
            "properties": {
                "node_id": {
                    "type": "string"
                },
                "concept_name": {
                    "type": "string"
                },
                "relevant_raw_text": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "ValidatorInput": {
            "type": "object",
            "required": [
                "draft_explanation",
                "source_raw_text"
            ],
            "properties": {
                "draft_explanation": {
                    "type": "string"
                },
                "source_raw_text": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "SynthesizerInput": {
            "type": "object",
            "required": [
                "validated_nodes"
            ],
            "properties": {
                "validated_nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ExpertOutput"
                    }
                }
            },
            "additionalProperties": false
        },
        "DAGEdge": {
            "type": "object",
            "required": [
                "source",
                "target"
            ],
            "properties": {
                "source": {
                    "type": "string"
                },
                "target": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "StructuralAuditorInput": {
            "type": "object",
            "required": [
                "skill_tree_nodes",
                "final_dag"
            ],
            "properties": {
                "skill_tree_nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ExpertOutput"
                    }
                },
                "final_dag": {
                    "$ref": "#/definitions/SynthesizerOutput"
                }
            },
            "additionalProperties": false
        },
        "CartographerOutput": {
            "type": "object",
            "required": [
                "nodes",
                "skeleton_dag"
            ],
            "properties": {
                "nodes": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "node_id",
                            "concept_name",
                            "icon_name",
                            "source_section_header"
                        ],
                        "properties": {
                            "node_id": {
                                "type": "string"
                            },
                            "concept_name": {
                                "type": "string"
                            },
                            "icon_name": {
                                "type": "string"
                            },
                            "source_section_header": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "skeleton_dag": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/DAGEdge"
                    }
                }
            },
            "additionalProperties": false
        },
        "ExpertOutput": {
            "type": "object",
            "required": [
                "node_id",
                "explanation",
                "prerequisite_node_ids"
            ],
            "properties": {
                "node_id": {
                    "type": "string"
                },
                "explanation": {
                    "type": "string"
                },
                "prerequisite_node_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "ValidatorOutput": {
            "type": "object",
            "required": [
                "is_valid",
                "hallucination_flags"
            ],
            "properties": {
                "is_valid": {
                    "type": "boolean"
                },
                "hallucination_flags": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "claim",
                            "issue_description"
                        ],
                        "properties": {
                            "claim": {
                                "type": "string"
                            },
                            "issue_description": {
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                }
            },
            "additionalProperties": false
        },
        "SynthesizerOutput": {
            "type": "object",
            "required": [
                "directed_acyclic_graph"
            ],
            "properties": {
                "directed_acyclic_graph": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/DAGEdge"
                    }
                }
            },
            "additionalProperties": false
        },
        "StructuralAuditorOutput": {
            "type": "object",
            "required": [
                "is_valid",
                "reasoning",
                "suggested_changes"
            ],
            "properties": {
                "is_valid": {
                    "type": "boolean"
                },
                "reasoning": {
                    "type": "string"
                },
                "suggested_changes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "RecruiterOutput": {
            "type": "object",
            "required": [
                "field_of_study",
                "specialists"
            ],
            "properties": {
                "field_of_study": {
                    "type": "string"
                },
                "specialists": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "CouncilMemberResponse": {
            "type": "object",
            "required": [
                "message",
                "role"
            ],
            "properties": {
                "message": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                }
            }
        },
        "CouncilDesignOutput": {
            "type": "object",
            "required": [
                "progression_strategy",
                "cartographer_instructions",
                "expert_instructions",
                "evaluator_instructions_template"
            ],
            "properties": {
                "progression_strategy": {
                    "type": "string"
                },
                "cartographer_instructions": {
                    "type": "string"
                },
                "expert_instructions": {
                    "type": "string"
                },
                "evaluator_instructions_template": {
                    "type": "string"
                },
                "revision_rationale": {
                    "type": "string"
                }
            }
        },
        "CouncilAudit": {
            "type": "object",
            "required": [
                "is_approved"
            ],
            "properties": {
                "is_approved": {
                    "type": "boolean"
                },
                "critique": {
                    "type": "string"
                }
            }
        },
        "CouncilReviewOutput": {
            "type": "object",
            "required": [
                "is_acceptable",
                "critique"
            ],
            "properties": {
                "is_acceptable": {
                    "type": "boolean"
                },
                "critique": {
                    "type": "string"
                }
            }
        },
        "EvaluatorRubric": {
            "type": "object",
            "required": [
                "instructions",
                "rubric_a_plus",
                "rubric_a",
                "rubric_a_minus",
                "rubric_b_plus",
                "rubric_b",
                "rubric_b_minus",
                "rubric_c_plus",
                "rubric_c",
                "rubric_c_minus",
                "rubric_d_plus",
                "rubric_d",
                "rubric_d_minus",
                "rubric_f"
            ],
            "properties": {
                "instructions": {
                    "type": "string"
                },
                "rubric_a_plus": {
                    "type": "string"
                },
                "rubric_a": {
                    "type": "string"
                },
                "rubric_a_minus": {
                    "type": "string"
                },
                "rubric_b_plus": {
                    "type": "string"
                },
                "rubric_b": {
                    "type": "string"
                },
                "rubric_b_minus": {
                    "type": "string"
                },
                "rubric_c_plus": {
                    "type": "string"
                },
                "rubric_c": {
                    "type": "string"
                },
                "rubric_c_minus": {
                    "type": "string"
                },
                "rubric_d_plus": {
                    "type": "string"
                },
                "rubric_d": {
                    "type": "string"
                },
                "rubric_d_minus": {
                    "type": "string"
                },
                "rubric_f": {
                    "type": "string"
                }
            }
        }
    }
}